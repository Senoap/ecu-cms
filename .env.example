# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - PT EMPAT SINERGI UTAMA
# ==============================================================================
# Project ini mendukung 3 environment:
# 1. .env.dev  / .env.local -> Development lokal (npm run env:dev)
# 2. .env.stg               -> UAT / Staging di Supabase Cloud (npm run env:stg)
# 3. .env.prod              -> Production di Supabase Cloud (npm run env:prod)
# ==============================================================================

# SUPABASE CREDENTIALS
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# KEAMANAN CMS & ADMIN
SESSION_SECRET=kunci_rahasia_acak_minimal_32_karakter
ADMIN_PASSWORD=password_master_admin

# ==============================================================================
# SMTP EMAIL SERVER (UNTUK PENGIRIMAN COMPANY PROFILE & NOTIFIKASI HR)
# ==============================================================================
# Mendukung Mailspace, cPanel Webmail, Google Workspace, Brevo, dsb.
#
# CONTOH UNTUK MAILSPACE / CPANEL DOMAIN SENDIRI:
# SMTP_HOST=mail.empatsinergiutama.com   # atau smtp.mailspace.id
# SMTP_PORT=465                          # 465 (SSL) atau 587 (TLS/STARTTLS)
# SMTP_SECURE=true                       # true jika port 465, false jika port 587
# SMTP_USER=marketing@empatsinergiutama.com
# SMTP_PASS=PasswordAkunEmailAnda
# MAIL_FROM="PT Empat Sinergi Utama <marketing@empatsinergiutama.com>"
#
# Opsi Tambahan jika Server Hosting Menggunakan Sertifikat Shared / SNI:
# SMTP_REJECT_UNAUTHORIZED=false         # default: false (aman dari error sertifikat self-signed)
